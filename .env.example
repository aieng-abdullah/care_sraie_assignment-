# Copy to .env for local runs. NEVER commit .env — placeholders only in this file.

# --- Core (required; app refuses to start without these) ---
DATABASE_URL=postgresql+psycopg://docintel:docintel@localhost:5432/docintel
REDIS_URL=redis://localhost:6379/0
LLM_API_KEY=gsk_replace_me

# --- LLM extraction (Groq, OpenAI-compatible API) ---
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=30

# --- Embeddings for semantic search (OpenAI); used from search milestone ---
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536


# --- Limits (NFR: upload caps, rate limits) ---
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=1000
RATE_LIMIT_UPLOADS_PER_MINUTE=60

# --- Storage / OCR ---
UPLOAD_DIR=data/uploads
OCR_ENGINE=tesseract

# --- Logging / environment ---
ENVIRONMENT=development
LOG_LEVEL=INFO
SERVICE_NAME=docintel-backend
